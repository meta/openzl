load("@fbsource//tools/target_determinator/macros:ci.bzl", "ci")
load("../../../../defs.bzl", "relative_headers")

oncall("data_compression")

# Device-runtime operations used by the host decode code; runtime-agnostic.
cpp_library(
    # @autodeps-skip
    name = "device",
    srcs = ["device.cpp"],
    headers = relative_headers(["device.hpp"]),
    header_namespace = "",
    deps = [":decode_dispatch"],
    exported_deps = [
        "../../../..:zstronglib",
        "../../../../cpp:openzl_cpp",
        "../common:codec_decode_execution",
    ],
)

# Selects a kernel for each codec run and batches runs by kernel. Every runtime
# shares it.
cpp_library(
    # @autodeps-skip
    name = "decode_dispatch",
    srcs = ["decode_dispatch.cpp"],
    headers = relative_headers(["decode_dispatch.hpp"]),
    header_namespace = "",
    deps = ["../../../..:zstronglib"],
    exported_deps = ["../common:codec_decode_execution"],
)

cpp_unittest(
    # @autodeps-skip
    name = "decode_dispatch_test",
    srcs = ["tests/DecodeDispatchTest.cpp"],
    network_access = network_access_utils.none(),
    deps = [
        "fbsource//third-party/googletest:gtest",
        ":decode_dispatch",
    ],
)

# The process's nvcomp 5, loaded once for every kernel that uses it.
cpp_library(
    # @autodeps-skip
    name = "nvcomp",
    srcs = ["nvcomp.cpp"],
    headers = relative_headers(["nvcomp.hpp"]),
    header_namespace = "",
)

cpp_unittest(
    # @autodeps-skip
    name = "nvcomp_test",
    srcs = ["tests/NvcompTest.cpp"],
    network_access = network_access_utils.none(),
    deps = [
        "fbsource//third-party/googletest:gtest",
        ":nvcomp",
    ],
)

cpp_library(
    # @autodeps-skip
    name = "cuda_device",
    srcs = [
        "cuda_device.cpp",
        "cuda_kernel_table.cpp",
    ],
    headers = relative_headers([
        "cuda_kernel_table.hpp",
        "cuda_device.hpp",
    ]),
    header_namespace = "",
    deps = [
        "../../../..:zstronglib",
        "../codecs/float_deconstruct:decode_float_deconstruct_cuda",
        "../codecs/zstd:decode_zstd_cuda",
    ],
    exported_deps = [":device"],
    external_deps = [("cuda", None, "cuda-lazy")],
)

cpp_unittest(
    # @autodeps-skip
    name = "cuda_device_test",
    srcs = ["tests/CudaDeviceTest.cpp"],
    keep_gpu_sections = True,
    labels = [tpx_labels.serialize]
    + ci.labels(
        ci.replace({ci.linux(ci.dev()): ci.linux(ci.mode("fbcode//mode/dev-nosan"))}),
        ci.remove(ci.linux(ci.coverage(ci.mode("fbcode//mode/dev-cov")))),
    ),
    network_access = network_access_utils.none(),
    remote_execution = re_test_utils.remote_execution(
        platform = "gpu-remote-execution",
        use_case = "tpx-default",
    ),
    target_compatible_with = sanitizers.sanitizer_enabled(
        no = [],
        yes = ["ovr_config//:none"],
    ),
    deps = [
        "../common:cuda_raii",
        "fbsource//third-party/googletest:gtest",
        ":cuda_device",
    ],
    external_deps = [("cuda", None, "cuda-lazy")],
)
